{
  "name": "satmer-phone-system",
  "version": "1.0.0",
  "description": "IVR Phone System for Chesed Activity Management",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "migrate": "sequelize db:migrate",
    "seed": "sequelize db:seed:all",
    "build": "npm install --prefix frontend && npm run build --prefix frontend"
  },
  "keywords": [
    "ivr",
    "phone",
    "chesed"
  ],
  "author": "Satmer",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-validator": "^7.0.0",
    "form-data": "^4.0.0",
    "jsonwebtoken": "^9.0.2",
    "msedge-tts": "^2.0.7",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "pg": "^8.11.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.35.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "sequelize-cli": "^6.6.2"
  }
}

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=satmer_db
DB_USER=postgres
DB_PASSWORD=your_password

# Server
PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRATION=7d

# Technoline API (for IVR and voice notifications)
TECHNOLINE_API_KEY=your_api_key
TECHNOLINE_API_URL=https://api.ipsales.co.il/api
TECHNOLINE_PBX_ID=your_pbx_id
APP_URL=https://your-domain.com

# Admin Settings
ADMIN_PHONE=your_admin_phone
RESET_DATE_HEBREW=1_Sivan

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=satmer_db
DB_USER=postgres
DB_PASSWORD=your_password

# Server
PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRATION=7d

# Technoline API (for IVR extensions and voice notifications)
TECHNOLINE_API_KEY=your_api_key
# IVR Extensions Management API (phone tree, files, permissions)
TECHNOLINE_IVR_API_URL=https://app.tlivr.com/ivrFilesApi.php
# Campaign API (outbound voice calls / weekly reminders)
TECHNOLINE_CAMPAIGN_API_URL=https://app.ipsales.co.il/campaignApi.php
# Shared secret placed in the extension's api_add_0=token=... parameter,
# so only Technoline's PBX (not a random request) can drive the call flow
TECHNOLINE_PBX_TOKEN=choose_a_random_secret
# Extension used to store pre-synthesized speech clips (see src/services/speech.js)
TECHNOLINE_AUDIO_EXTENSION=your_audio_extension_id
APP_URL=https://your-domain.com

# Admin Settings
# Bootstraps (or promotes) an admin user on startup, so the website login
# works from a fresh deploy without a manual DB step.
ADMIN_ID_NUMBER=your_israeli_id_number
ADMIN_NAME=מנהלת מערכת
ADMIN_PHONE=your_admin_phone
RESET_DATE_HEBREW=1_Sivan

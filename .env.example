# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=satmer_db
DB_USER=postgres
DB_PASSWORD=your_password

# Server
PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRATION=7d

# Technoline API (for IVR extensions and voice notifications)
TECHNOLINE_API_KEY=your_api_key
# IVR Extensions Management API (phone tree, files, permissions)
TECHNOLINE_IVR_API_URL=https://app.tlivr.com/ivrFilesApi.php
# Campaign API (outbound voice calls / weekly reminders)
TECHNOLINE_CAMPAIGN_API_URL=https://app.ipsales.co.il/campaignApi.php
APP_URL=https://your-domain.com

# Admin Settings
ADMIN_PHONE=your_admin_phone
RESET_DATE_HEBREW=1_Sivan
